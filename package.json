{
  "name": "keydra-frontend",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_MOCK_API=true vite",
    "dev:telemetry": "VITE_FARO_URL=http://localhost:12347/collect vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run --coverage",
    "test:ci": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc -b",
    "eslint:check": "eslint .",
    "eslint:apply": "eslint . --fix",
    "prettier:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"locales/**/*.json\" \"*.{ts,js,json}\"",
    "prettier:apply": "prettier --write \"src/**/*.{ts,tsx,css}\" \"locales/**/*.json\" \"*.{ts,js,json}\"",
    "lint": "yarn prettier:check && yarn eslint:check && yarn type-check"
  },
  "dependencies": {
    "@grafana/faro-web-sdk": "2.11.0",
    "@grafana/faro-web-tracing": "2.11.0",
    "@patternfly/react-catalog-view-extension": "6.5.0",
    "@patternfly/react-charts": "8.6.1",
    "@patternfly/react-component-groups": "^6.5.0",
    "@patternfly/react-core": "6.6.1",
    "@patternfly/react-data-view": "^6.5.0",
    "@patternfly/react-icons": "6.6.1",
    "@patternfly/react-table": "6.6.1",
    "@tanstack/react-query": "5.102.6",
    "@tanstack/react-virtual": "3.14.10",
    "@xyflow/react": "^12.11.5",
    "i18next": "26.4.0",
    "i18next-browser-languagedetector": "8.2.1",
    "motion": "13.1.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.12",
    "react-router": "8.3.0",
    "victory-area": "37.3.6",
    "victory-axis": "37.3.6",
    "victory-bar": "37.3.6",
    "victory-box-plot": "37.3.6",
    "victory-chart": "37.3.6",
    "victory-core": "37.3.6",
    "victory-create-container": "37.3.6",
    "victory-cursor-container": "37.3.6",
    "victory-group": "37.3.6",
    "victory-legend": "37.3.6",
    "victory-line": "37.3.6",
    "victory-pie": "37.3.6",
    "victory-scatter": "37.3.6",
    "victory-stack": "37.3.6",
    "victory-tooltip": "37.3.6",
    "victory-voronoi-container": "37.3.6",
    "victory-zoom-container": "37.3.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "22.20.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "msw": "2.15.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.11"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
